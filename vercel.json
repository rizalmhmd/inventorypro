{
  "outputDirectory": "public",
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.7.3" }
  },
  "routes": [
    { "src": "/build/(.*)", "dest": "/public/build/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "env": {
  "APP_ENV": "production",
  "APP_DEBUG": "false",
  "LOG_CHANNEL": "stderr",
  "SESSION_DRIVER": "cookie",
  "CACHE_DRIVER": "array",
  "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
  "CONFIG_CACHE": "/tmp/config.php",
  "ROUTES_CACHE": "/tmp/routes.php",
  "EVENTS_CACHE": "/tmp/events.php",
  "SERVICES_CACHE": "/tmp/services.php",
  "PACKAGES_CACHE": "/tmp/packages.php"
}
}